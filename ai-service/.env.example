# ════════════════════════════════════════════════════════════════════
# AI Service — Environment Configuration
# ════════════════════════════════════════════════════════════════════

# Shared secret with Node.js backend (must match BACKEND's AI_SERVICE_API_KEY)
AI_SERVICE_API_KEY=change-me-in-production

# Node.js backend URL (for callbacks / event push)
BACKEND_URL=http://localhost:3000

# Tesseract OCR binary path (override if not on PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
