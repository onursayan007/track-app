# ════════════════════════════════════════════════════════════════════
# Fleet Tracking Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL via Prisma) ─────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleet_tracking?schema=public"

# ─── JWT (stateless auth — PWA & Native App compatible) ───────────
JWT_SECRET=super-secret-change-me-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── External Services (optional) ────────────────────────────────
GOOGLE_MAPS_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# ─── Redis (telemetry ingestion buffer) ──────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Telemetry Pipeline ─────────────────────────────────────────
TELEMETRY_TCP_PORT=5001
TELEMETRY_UDP_PORT=5002
TELEMETRY_BATCH_SIZE=500
TELEMETRY_BATCH_INTERVAL_MS=2000
TELEMETRY_STREAM_KEY=telemetry:raw
TELEMETRY_CONSUMER_GROUP=telemetry-workers
